# local copy of the competition data (re-downloadable: kaggle competitions download -c playground-series-s6e8 -p data --unzip)
data/
# kaggle kernels output scratch
.kaggle_output/
__pycache__/
*.pyc
# per-run prediction artifacts (large CSVs; runs.csv stays tracked)
experiments/preds/
experiments/blends/
