# local copy of the competition data (re-downloadable: kaggle competitions download -c playground-series-s6e8 -p data --unzip)
data/
# kaggle kernels output scratch
.kaggle_output/
__pycache__/
*.pyc
# per-run prediction artifacts (large CSVs; runs.csv stays tracked)
experiments/preds/
experiments/blends/
# harvested public submission/artifact bank (large, not ours to redistribute)
experiments/bank/
# public OOF library, attached as a DIAGNOSTIC only (never an input to a submission).
# ~585 MB and not ours to redistribute; re-fetch with
#   kaggle datasets download szymonkapiski/s6e8-oof-library-47-models -p experiments/public_lib --unzip
experiments/public_lib/
# single-model file submissions built from per-learner proba artifacts
experiments/singles/
# auto-submit queue state + logs (reference gitignored local CSVs; runs.csv stays tracked)
experiments/queue.json
experiments/submit_log.csv
experiments/.submit_queue.lock
logs/

# pytorch_tabular / lightning run debris
lightning_logs/
saved_models/
.pt_tmp/
